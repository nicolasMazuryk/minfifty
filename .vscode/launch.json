{
  "configurations": [
    {
      "name": "aws-lambda-binance",
      "type": "node",
      "request": "launch",
      "program": "${workspaceRoot}/strategy/aws_lambda_binance/index.cjs",
      "skipFiles": [
          "<node_internals>/**"
      ],
    },
    {
      "name": "ws-order-monitoring",
      "type": "node",
      "request": "launch",
      "program": "${workspaceRoot}/strategy/ws-order-monitoring/ws.ts",
      "runtimeExecutable": "${workspaceRoot}/strategy/ws-order-monitoring/node_modules/.bin/tsx",
    
      "internalConsoleOptions": "openOnSessionStart",
    
      "skipFiles": [
          "<node_internals>/**"
      ],
    }
  ],
}