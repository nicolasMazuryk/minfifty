{
  "name": "server-workspace",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=16.x"
  },
  "scripts": {
    "start": "tsc-watch -p tsconfig.json --onSuccess 'node --inspect ./build/index.js'",
    "start:prod": "npm run build && node -r source-map-support/register ./build/index.js",
    "sync-market-data": "npx ts-node --project tsconfig.json src/strategy/sync-market-data.ts",
    "test": "jest",
    "build": "rm -rf build && tsc -b",
    "prettify": "prettier --write .",
    "lint": "eslint  --fix \"{src,tests}/**/*.{ts,js}\"",
    "migration:generate": "node scripts/migration_generate.js add_symbols_table",
    "migration:do": "npm run build && npx sequelize-cli db:migrate",
    "migration:undo": "npm run build && npx sequelize-cli db:migrate:undo",
    "migration:undo-all-to": "npm run build && npx sequelize-cli db:migrate:undo:all --to XXXXXX.js"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/body-parser": "^1.19.2",
    "@types/bunyan": "^1.8.8",
    "@types/cors": "^2.8.12",
    "@types/dotenv-safe": "^8.1.2",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.17.4",
    "@types/jest": "^28.1.6",
    "@types/json-pointer": "^1.0.31",
    "@types/jsonpath": "^0.2.0",
    "@types/lodash": "^4.14.182",
    "@types/module-alias": "^2.0.1",
    "@types/node": "^18.6.3",
    "@types/nodemailer": "^6.4.4",
    "@types/nodemailer-stub-transport": "^1.1.5",
    "@types/pg": "^8.6.5",
    "@types/sequelize": "^4.28.14",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "husky": "^8.0.1",
    "jest": "^28.1.3",
    "lint-staged": "^13.0.3",
    "nodemon": "^2.0.16",
    "prettier": "^2.6.2",
    "supertest": "^6.2.4",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.7.0",
    "tsc-watch": "^5.0.3",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "@types/csv-parse": "^1.2.2",
    "axios": "^0.27.2",
    "body-parser": "^1.20.0",
    "bunyan": "^1.8.15",
    "connect-multiparty": "^2.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.3.0",
    "dotenv": "^16.0.0",
    "dotenv-expand": "^8.0.3",
    "dotenv-safe": "^8.2.0",
    "express": "^4.18.1",
    "express-session": "^1.17.3",
    "extract-zip": "^2.0.1",
    "json-pointer": "^0.6.2",
    "jsonpath": "^1.1.1",
    "livr": "^2.3.3",
    "livr-extra-rules": "^1.2.1",
    "lodash": "^4.17.21",
    "module-alias": "^2.2.2",
    "mongoose": "6.3.1",
    "nodemailer": "^6.7.4",
    "nodemailer-sendmail-transport": "^1.0.2",
    "nodemailer-smtp-transport": "^2.7.4",
    "nodemailer-stub-transport": "^1.1.0",
    "pg": "^8.7.3",
    "rename-keys": "^2.0.1",
    "sequelize": "^6.21.3",
    "sequelize-cli": "^6.4.1",
    "source-map-support": "^0.5.21"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "exec": "ts-node --files ./src/index.ts",
    "ext": "ts"
  },
  "_moduleAliases": {
    "@": "build"
  }
}
