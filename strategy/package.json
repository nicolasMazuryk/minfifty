{
  "name": "strategy-workspace",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=16.x"
  },
  "scripts": {
    "sync-market-data": "npx ts-node --project tsconfig.json src/scripts/sync-market-data.ts",
    "backtest": "npx ts-node --project tsconfig.json src/scripts/run-backtest.ts",
    "real-time": "npx ts-node --project tsconfig.json src/scripts/run-real-time.ts",
    "build": "rm -rf build && tsc -b",
    "prettify": "prettier --write .",
    "lint": "eslint  --fix \"{src,tests}/**/*.{ts,js}\"",
    "migration:generate": "node src/scripts/migration_generate.js add_chart_visualisation_table",
    "migration:do": "npm run build && npx sequelize-cli db:migrate",
    "migration:undo": "npm run build && npx sequelize-cli db:migrate:undo",
    "migration:undo-all-to": "npm run build && npx sequelize-cli db:migrate:undo:all --to XXXXXX.js"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/csv-parse": "^1.2.2",
    "@types/dotenv-safe": "^8.1.2",
    "@types/module-alias": "^2.0.1",
    "@types/node": "^18.6.3",
    "@types/pg": "^8.6.5",
    "@types/sequelize": "^4.28.14",
    "@types/uuid": "^9.0.1",
    "@types/uuidv4": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.6.2",
    "ts-node": "^10.7.0",
    "tsc-watch": "^5.0.3",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "binance-api-node": "^0.11.46",
    "csv-parse": "^5.3.0",
    "dotenv": "^16.0.0",
    "dotenv-expand": "^8.0.3",
    "dotenv-safe": "^8.2.0",
    "extract-zip": "^2.0.1",
    "module-alias": "^2.2.2",
    "pg": "^8.7.3",
    "sequelize": "^6.21.3",
    "sequelize-cli": "^6.4.1",
    "source-map-support": "^0.5.21",
    "uuidv4": "^6.2.13"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "exec": "ts-node --files ./src/index.ts",
    "ext": "ts"
  },
  "_moduleAliases": {
    "@": "build"
  }
}
